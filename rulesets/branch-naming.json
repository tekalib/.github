{
  "name": "Conventional Branch Naming",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "repository_name": { "include": ["~ALL"], "exclude": [] },
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/develop",
        "refs/heads/feat/*",
        "refs/heads/fix/*",
        "refs/heads/hotfix/*",
        "refs/heads/refactor/*",
        "refs/heads/perf/*",
        "refs/heads/test/*",
        "refs/heads/docs/*",
        "refs/heads/chore/*",
        "refs/heads/build/*",
        "refs/heads/ci/*",
        "refs/heads/style/*",
        "refs/heads/revert/*",
        "refs/heads/release/*",
        "refs/heads/dependabot/**/*",
        "refs/heads/revert-*",
        "refs/heads/revert-*/**/*"
      ]
    }
  },
  "rules": [{ "type": "creation" }]
}
