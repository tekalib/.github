{
  "name": "Trunk Protection",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "repository_name": { "include": ["~ALL"], "exclude": [] },
    "ref_name": {
      "include": ["~DEFAULT_BRANCH", "refs/heads/develop"],
      "exclude": []
    }
  },
  "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }]
}
